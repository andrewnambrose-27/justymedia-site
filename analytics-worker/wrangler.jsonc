{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "justy-media-analytics",
	"main": "src/index.js",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "analytics.justymedia.co.uk",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "justy-media-analytics",
			"database_id": "ae3613ea-073e-41f8-8fa4-22258c9051ea",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
